// Service Management System (SMS) - Prisma Schema
// Covers Phases 1-5 of the PRD roadmap (docs/SMS-PRD.md, Section 18.3)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Supabase Supavisor/pgbouncer) — used by the app at runtime.
  url       = env("DATABASE_URL")
  // Direct/session connection — used only by `prisma migrate`/`db push`, which need
  // advisory locks that the transaction pooler doesn't support.
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  PROJECT_MANAGER
  SUPERVISOR
  SITE_INSPECTOR
  TECHNICIAN
  ACCOUNTANT
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum CustomerType {
  INDIVIDUAL
  CORPORATE
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PreferredContactMethod {
  PHONE
  EMAIL
  SMS
  WHATSAPP
}

enum CustomerSource {
  WALK_IN
  REFERRAL
  WEBSITE
  SOCIAL_MEDIA
  ADVERTISEMENT
  PHONE_INQUIRY
  OTHER
}

enum CustomerNoteVisibility {
  INTERNAL
  PUBLIC
}

enum CustomerDocumentCategory {
  CONTRACT
  INVOICE
  PHOTO
  DRAWING
  RECEIPT
  WARRANTY
  IDENTITY
  OTHER
}

enum EmployeeDocumentCategory {
  ID_CARD
  CONTRACT
  CERTIFICATE
  RESUME
  OTHER
}

enum ServiceRequestStatus {
  NEW
  UNDER_REVIEW
  SITE_INSPECTION_SCHEDULED
  INSPECTION_COMPLETED
  QUOTATION_SENT
  APPROVED
  CONVERTED_TO_PROJECT
  REJECTED
  CANCELLED
  CLOSED
}

enum ServiceRequestPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InspectionStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AttachmentType {
  PHOTO
  VIDEO
  DRAWING
  DOCUMENT
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  REVISED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum QuotationItemCategory {
  MATERIAL
  LABOR
  TRANSPORTATION
}

enum QuotationApprovalAction {
  APPROVED
  REJECTED
}

enum ProjectStatus {
  PLANNING
  SCHEDULED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CLOSED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELAYED
}

// Responsibility a staff member holds on a Project (Staff Registration feature).
enum StaffResponsibility {
  SUPERVISOR
  TECHNICIAN
  INSTALLER
  ELECTRICIAN
  CARPENTER
  PLUMBER
  PAINTER
  DRIVER
  HELPER
  OTHER
}

enum TaskStatus {
  TODO
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  VERIFIED
  REOPENED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PhotoType {
  BEFORE
  PROGRESS
  AFTER
}

enum ServiceCategoryGroup {
  FURNITURE
  ALUMINUM
  CCTV
  PVC
  MOVING
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

enum LeaveStatus {
  REQUESTED
  APPROVED
  REJECTED
}

enum MaterialEntryType {
  ESTIMATED
  ACTUAL
}

enum ExpenseCategory {
  MATERIAL
  LABOR
  TRANSPORT
  EQUIPMENT_RENTAL
  OTHER
}

enum ExpenseStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CARD
}

enum NotificationType {
  SERVICE_REQUEST_ASSIGNED
  INSPECTION_SCHEDULED
  QUOTATION_SENT
  QUOTATION_APPROVED
  QUOTATION_REJECTED
  INSPECTION_COMPLETED
  TASK_ASSIGNED
  PROJECT_STATUS_CHANGED
  INVOICE_ISSUED
  PAYMENT_RECEIVED
  FEEDBACK_REQUEST
  GENERIC
}

// ─────────────────────────────────────────────────────────────────────────
// PHASE 1 — FOUNDATION: Auth, Users, Company Settings, Customers
// ─────────────────────────────────────────────────────────────────────────

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  passwordHash        String
  fullName            String
  phone               String?
  employeeId          String?    @unique
  department          String?
  jobTitle            String?
  address             String?
  hireDate            DateTime?
  photoUrl            String?
  role                Role
  status              UserStatus @default(ACTIVE)
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  refreshTokens             RefreshToken[]
  employeeDocuments         EmployeeDocument[]       @relation("EmployeeDocumentOwner")
  employeeDocumentsUploaded EmployeeDocument[]       @relation("EmployeeDocumentUploadedBy")
  technicianProfile         TechnicianProfile?
  customerProfile           Customer?                @relation("CustomerUser")
  createdCustomers          Customer[]               @relation("CustomerCreatedBy")
  deletedCustomers          Customer[]               @relation("CustomerDeletedBy")
  assignedCustomers         Customer[]               @relation("CustomerAssignedTechnician")
  customerNotesAuthored     CustomerNote[]           @relation("CustomerNoteAuthor")
  customerDocumentsUploaded CustomerDocument[]       @relation("CustomerDocumentUploadedBy")
  createdServices           Service[]                @relation("ServiceCreatedBy")
  ownedServiceRequests      ServiceRequest[]         @relation("ServiceRequestOwner")
  createdServiceRequests    ServiceRequest[]         @relation("ServiceRequestCreatedBy")
  inspections               SiteInspection[]         @relation("InspectorUser")
  createdQuotations         Quotation[]              @relation("QuotationCreatedBy")
  managedProjects           Project[]                @relation("ProjectManager")
  supervisedProjects        ProjectSupervisor[]
  staffAssignments          ProjectStaffAssignment[] @relation("ProjectStaffAssignmentUser")
  staffAssignmentsMade      ProjectStaffAssignment[] @relation("ProjectStaffAssignmentAssignedBy")
  createdTasks              Task[]                   @relation("TaskCreatedBy")
  taskAssignments           TaskAssignment[]
  submittedExpenses         Expense[]                @relation("ExpenseSubmittedBy")
  approvedExpenses          Expense[]                @relation("ExpenseApprovedBy")
  recordedPayments          Payment[]                @relation("PaymentRecordedBy")
  notifications             Notification[]
  auditLogs                 AuditLog[]
  passwordResetTokens       PasswordResetToken[]
  userRoles                 UserRole[]

  @@index([role])
  @@index([status])
  @@index([department])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Employee Management: ID cards, contracts, certificates, etc. attached to a
// staff User. Shares the same signed-upload flow as CustomerDocument/ProjectDocument.
model EmployeeDocument {
  id           String                   @id @default(uuid())
  userId       String
  category     EmployeeDocumentCategory @default(OTHER)
  fileName     String
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  uploadedById String?
  createdAt    DateTime                 @default(now())

  user       User  @relation("EmployeeDocumentOwner", fields: [userId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation("EmployeeDocumentUploadedBy", fields: [uploadedById], references: [id])

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// DYNAMIC RBAC — Role/Permission/UserRole management (Phase "Authentication
// & Authorization" deliverable: "Role & permission management"). Named
// AppRole/AppPermission to avoid colliding with the existing `Role` enum,
// which remains each User's primary role for JWT claims and the handful of
// identity-scoped business rules (e.g. only a Super Admin may create another
// Super Admin) that aren't really "permissions" in the grantable sense.
// requirePermission() middleware is the actual route-level authorization
// mechanism; requireRole() is now reserved for identity-scoped self-service
// routes (Customer/Technician/Site Inspector acting on their own records).
// ─────────────────────────────────────────────────────────────────────────

model AppRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]
}

model AppPermission {
  id          String   @id @default(uuid())
  key         String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([module])
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       AppRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AppPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role AppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CompanySettings {
  id                        String   @id @default(uuid())
  name                      String
  tagline                   String?
  logoUrl                   String?
  address                   String?
  phone                     String?
  email                     String?
  website                   String?
  taxRegistrationNo         String?
  taxRatePercent            Decimal  @default(0) @db.Decimal(5, 2)
  currency                  String   @default("USD")
  quotationValidityDays     Int      @default(15)
  discountApprovalThreshold Decimal  @default(15) @db.Decimal(5, 2)
  expenseApprovalThreshold  Decimal  @default(500) @db.Decimal(12, 2)
  invoiceDueDays            Int      @default(15)
  numberingConfig           Json?
  updatedAt                 DateTime @updatedAt
}

model Customer {
  id                     String                 @id @default(uuid())
  userId                 String?                @unique
  sequenceNo             Int                    @unique @default(autoincrement())
  customerCode           String                 @unique
  type                   CustomerType           @default(INDIVIDUAL)
  fullName               String
  companyName            String?
  email                  String?
  phone                  String
  alternatePhone         String?
  nationalId             String?
  gender                 Gender?
  dateOfBirth            DateTime?
  preferredContactMethod PreferredContactMethod @default(PHONE)
  source                 CustomerSource         @default(OTHER)
  billingAddress         String?
  status                 CustomerStatus         @default(ACTIVE)
  tags                   String[]               @default([])
  assignedTechnicianId   String?
  createdById            String?
  deletedAt              DateTime?
  deletedById            String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  user               User?                 @relation("CustomerUser", fields: [userId], references: [id])
  createdBy          User?                 @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  deletedBy          User?                 @relation("CustomerDeletedBy", fields: [deletedById], references: [id])
  assignedTechnician User?                 @relation("CustomerAssignedTechnician", fields: [assignedTechnicianId], references: [id])
  siteAddresses      CustomerSiteAddress[]
  contacts           CustomerContact[]
  notes              CustomerNote[]
  documents          CustomerDocument[]
  serviceRequests    ServiceRequest[]
  quotations         Quotation[]
  quotationApprovals QuotationApproval[]
  projects           Project[]
  invoices           Invoice[]
  payments           Payment[]
  feedback           CustomerFeedback[]

  @@index([status])
  @@index([deletedAt])
  @@index([assignedTechnicianId])
  @@index([createdAt])
  @@index([type])
}

model CustomerSiteAddress {
  id          String   @id @default(uuid())
  customerId  String
  label       String
  addressLine String
  country     String?
  region      String?
  city        String?
  district    String?
  street      String?
  building    String?
  postalCode  String?
  landmark    String?
  mapLocation String?
  isDefault   Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceRequests ServiceRequest[]

  @@index([customerId])
}

model CustomerContact {
  id         String   @id @default(uuid())
  customerId String
  name       String
  position   String?
  phone      String?
  email      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model CustomerNote {
  id          String                 @id @default(uuid())
  customerId  String
  authorId    String?
  note        String
  visibility  CustomerNoteVisibility @default(INTERNAL)
  isPinned    Boolean                @default(false)
  attachments String[]               @default([])
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author   User?    @relation("CustomerNoteAuthor", fields: [authorId], references: [id])

  @@index([customerId])
}

model CustomerDocument {
  id           String                   @id @default(uuid())
  customerId   String
  category     CustomerDocumentCategory @default(OTHER)
  fileName     String
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  version      Int                      @default(1)
  replacesId   String?                  @unique
  uploadedById String?
  createdAt    DateTime                 @default(now())

  customer   Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  uploadedBy User?             @relation("CustomerDocumentUploadedBy", fields: [uploadedById], references: [id])
  replaces   CustomerDocument? @relation("CustomerDocumentVersion", fields: [replacesId], references: [id])
  replacedBy CustomerDocument? @relation("CustomerDocumentVersion")

  @@index([customerId])
  @@index([category])
}

// ─────────────────────────────────────────────────────────────────────────
// PHASE 2 — PRE-SALES: Service Catalog, Service Requests, Inspections, Quotations
// ─────────────────────────────────────────────────────────────────────────

model ServiceCategory {
  id                String   @id @default(uuid())
  name              String   @unique
  code              String   @unique
  description       String?
  unitOfMeasure     String
  basePrice         Decimal? @db.Decimal(12, 2)
  checklistTemplate Json?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  serviceRequests ServiceRequest[]
  quotationItems  QuotationLineItem[]

  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────────────────
// PHASE 05 — SERVICE MANAGEMENT: the installable-service catalog (Furniture,
// Aluminum, CCTV, PVC). Distinct from ServiceCategory above, which is the
// coarser catalog already wired into Service Request / Quotation creation —
// Service is a more granular, per-item catalog (duration, cost, materials)
// for the company's own service/pricing management, additively linkable
// from a Quotation line item without touching any existing flow.
// ─────────────────────────────────────────────────────────────────────────

model Service {
  id                String               @id @default(uuid())
  serviceName       String
  category          ServiceCategoryGroup
  description       String?
  durationMinutes   Int?
  estimatedCost     Decimal?             @db.Decimal(12, 2)
  requiredMaterials String[]             @default([])
  features          String[]             @default([])
  imageUrl          String?
  displayOrder      Int                  @default(0)
  notes             String?
  status            ServiceStatus        @default(ACTIVE)
  createdById       String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  createdBy       User?               @relation("ServiceCreatedBy", fields: [createdById], references: [id])
  quotationItems  QuotationLineItem[]
  serviceRequests ServiceRequest[]

  @@unique([serviceName, category])
  @@index([category])
  @@index([status])
  @@index([displayOrder])
}

model ServiceRequest {
  id                     String                 @id @default(uuid())
  referenceNo            String                 @unique
  customerId             String
  serviceCategoryId      String
  serviceId              String?
  title                  String?
  description            String
  projectLocation        String?
  projectType            String?
  expectedStartDate      DateTime?
  expectedCompletionDate DateTime?
  siteAddressId          String?
  preferredContactTime   DateTime?
  preferredDate          DateTime?
  priority               ServiceRequestPriority @default(MEDIUM)
  status                 ServiceRequestStatus   @default(NEW)
  ownerId                String?
  createdById            String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  customer        Customer                   @relation(fields: [customerId], references: [id])
  serviceCategory ServiceCategory            @relation(fields: [serviceCategoryId], references: [id])
  service         Service?                   @relation(fields: [serviceId], references: [id])
  siteAddress     CustomerSiteAddress?       @relation(fields: [siteAddressId], references: [id])
  owner           User?                      @relation("ServiceRequestOwner", fields: [ownerId], references: [id])
  createdBy       User?                      @relation("ServiceRequestCreatedBy", fields: [createdById], references: [id])
  attachments     ServiceRequestAttachment[]
  inspection      SiteInspection?
  quotations      Quotation[]

  @@index([status])
  @@index([priority])
  @@index([serviceId])
  @@index([customerId])
}

model ServiceRequestAttachment {
  id               String   @id @default(uuid())
  serviceRequestId String
  fileUrl          String
  fileName         String
  uploadedById     String?
  createdAt        DateTime @default(now())

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
}

model SiteInspection {
  id                    String           @id @default(uuid())
  inspectionNo          String           @unique
  serviceRequestId      String           @unique
  inspectorId           String
  scheduledAt           DateTime
  status                InspectionStatus @default(PENDING)
  siteAddress           String?
  landmark              String?
  city                  String?
  region                String?
  latitude              Decimal?         @db.Decimal(9, 6)
  longitude             Decimal?         @db.Decimal(9, 6)
  inspectionPurpose     String?
  customerRequirements  String?
  existingSiteCondition String?
  accessNotes           String?
  technicalNotes        String?
  internalNotes         String?
  materialEstimate      Json?
  laborEstimate         Json?
  materialCost          Decimal?         @db.Decimal(12, 2)
  laborCost             Decimal?         @db.Decimal(12, 2)
  transportationCost    Decimal?         @db.Decimal(12, 2)
  estimatedCost         Decimal?         @db.Decimal(12, 2)
  estimatedDuration     String?
  // Labor assessment — a rough on-site read of crew size/duration/skills, distinct from
  // laborEstimate's per-task cost breakdown used for quotation pricing.
  estimatedWorkers      Int?
  estimatedWorkingDays  Int?
  specialSkillsRequired String?
  // Transportation assessment — logistics notes, distinct from transportationCost.
  vehicleRequired       String?
  transportDistance     Decimal?         @db.Decimal(8, 2)
  accessibility         String?
  transportationNotes   String?
  cancelReason          String?
  submittedAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  serviceRequest ServiceRequest            @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  inspector      User                      @relation("InspectorUser", fields: [inspectorId], references: [id])
  checklistItems InspectionChecklistItem[]
  measurements   InspectionMeasurement[]
  photos         InspectionPhoto[]
  quotations     Quotation[]

  @@index([status])
  @@index([inspectorId])
}

model InspectionChecklistItem {
  id           String @id @default(uuid())
  inspectionId String
  key          String
  label        String
  value        Json?

  inspection SiteInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
}

model InspectionMeasurement {
  id           String   @id @default(uuid())
  inspectionId String
  label        String
  length       Decimal? @db.Decimal(10, 2)
  width        Decimal? @db.Decimal(10, 2)
  height       Decimal? @db.Decimal(10, 2)
  unit         String   @default("ft")
  quantity     Int?     @default(1)
  area         Decimal? @db.Decimal(10, 2)
  notes        String?

  inspection SiteInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
}

// Also covers videos/drawings/documents (see fileType) — kept as one model to avoid a
// near-duplicate table, since every attachment shares the same signed-upload flow.
model InspectionPhoto {
  id           String         @id @default(uuid())
  inspectionId String
  fileUrl      String
  fileType     AttachmentType @default(PHOTO)
  caption      String?
  createdAt    DateTime       @default(now())

  inspection SiteInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
}

model Quotation {
  id                   String          @id @default(uuid())
  quotationNo          String          @unique
  serviceRequestId     String
  siteInspectionId     String?
  customerId           String
  version              Int             @default(1)
  status               QuotationStatus @default(DRAFT)
  title                String?
  description          String?
  materialCost         Decimal         @default(0) @db.Decimal(12, 2)
  laborCost            Decimal         @default(0) @db.Decimal(12, 2)
  transportationCost   Decimal         @default(0) @db.Decimal(12, 2)
  subtotal             Decimal         @default(0) @db.Decimal(12, 2)
  // "VAT" in the spec — reuses the system's existing tax fields (also read directly by
  // Invoice generation) rather than adding a parallel vatPercentage/vatAmount pair that
  // could drift out of sync with it.
  taxRatePercent       Decimal         @default(0) @db.Decimal(5, 2)
  taxAmount            Decimal         @default(0) @db.Decimal(12, 2)
  discountType         DiscountType?
  discountValue        Decimal?        @db.Decimal(12, 2)
  discountAmount       Decimal         @default(0) @db.Decimal(12, 2)
  discountReason       String?
  discountApprovedById String?
  total                Decimal         @default(0) @db.Decimal(12, 2)
  validityDays         Int?
  validUntil           DateTime?
  notes                String?
  termsAndConditions   String?
  sentAt               DateTime?
  respondedAt          DateTime?
  customerComment      String?
  emailSentAt          DateTime?
  emailStatus          String?
  createdById          String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  serviceRequest ServiceRequest      @relation(fields: [serviceRequestId], references: [id])
  siteInspection SiteInspection?     @relation(fields: [siteInspectionId], references: [id])
  customer       Customer            @relation(fields: [customerId], references: [id])
  createdBy      User?               @relation("QuotationCreatedBy", fields: [createdById], references: [id])
  lineItems      QuotationLineItem[]
  auditLogs      QuotationAuditLog[]
  approvals      QuotationApproval[]
  project        Project?

  @@index([status])
  @@index([siteInspectionId])
  @@index([customerId])
  @@index([serviceRequestId])
}

model QuotationLineItem {
  id                String                @id @default(uuid())
  quotationId       String
  serviceCategoryId String?
  serviceId         String?
  category          QuotationItemCategory @default(MATERIAL)
  itemName          String?
  description       String
  quantity          Decimal               @db.Decimal(10, 2)
  unit              String
  unitPrice         Decimal               @db.Decimal(12, 2)
  subtotal          Decimal               @db.Decimal(12, 2)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  quotation       Quotation        @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  serviceCategory ServiceCategory? @relation(fields: [serviceCategoryId], references: [id])
  service         Service?         @relation(fields: [serviceId], references: [id])

  @@index([serviceId])
  @@index([category])
}

model QuotationApproval {
  id           String                  @id @default(uuid())
  quotationId  String
  customerId   String
  action       QuotationApprovalAction
  comments     String?
  approvedDate DateTime                @default(now())
  createdAt    DateTime                @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  customer  Customer  @relation(fields: [customerId], references: [id])

  @@index([quotationId])
}

model QuotationAuditLog {
  id          String   @id @default(uuid())
  quotationId String
  action      String
  actorId     String?
  note        String?
  createdAt   DateTime @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────
// PHASE 3 — DELIVERY: Projects, Tasks, Technicians, Scheduling
// ─────────────────────────────────────────────────────────────────────────

model Project {
  id                String        @id @default(uuid())
  projectNo         String        @unique
  quotationId       String        @unique
  customerId        String
  status            ProjectStatus @default(PLANNING)
  projectManagerId  String?
  startDate         DateTime?
  targetEndDate     DateTime?
  actualEndDate     DateTime?
  holdReason        String?
  cancelReason      String?
  completionPercent Decimal       @default(0) @db.Decimal(5, 2)
  customerSignOffAt DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  quotation        Quotation                @relation(fields: [quotationId], references: [id])
  customer         Customer                 @relation(fields: [customerId], references: [id])
  projectManager   User?                    @relation("ProjectManager", fields: [projectManagerId], references: [id])
  supervisors      ProjectSupervisor[]
  staffAssignments ProjectStaffAssignment[]
  milestones       ProjectMilestone[]
  documents        ProjectDocument[]
  tasks            Task[]
  materials        ProjectMaterial[]
  expenses         Expense[]
  invoices         Invoice[]
  feedback         CustomerFeedback[]

  @@index([status])
  @@index([customerId])
  @@index([projectManagerId])
}

model ProjectSupervisor {
  id        String @id @default(uuid())
  projectId String
  userId    String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
}

// Staff Registration feature: assigns a staff User to a Project with a responsibility
// and an optional date range. One row per (project, user) — editing responsibility/dates
// reuses the same row instead of creating a duplicate assignment.
model ProjectStaffAssignment {
  id             String              @id @default(uuid())
  projectId      String
  userId         String
  responsibility StaffResponsibility
  startDate      DateTime?
  endDate        DateTime?
  notes          String?
  assignedById   String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User    @relation("ProjectStaffAssignmentUser", fields: [userId], references: [id])
  assignedBy User?   @relation("ProjectStaffAssignmentAssignedBy", fields: [assignedById], references: [id])

  @@unique([projectId, userId])
  @@index([projectId])
}

model ProjectMilestone {
  id          String          @id @default(uuid())
  projectId   String
  name        String
  targetDate  DateTime?
  completedAt DateTime?
  status      MilestoneStatus @default(PENDING)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectDocument {
  id           String   @id @default(uuid())
  projectId    String
  fileUrl      String
  fileName     String
  uploadedById String?
  createdAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Task {
  id              String       @id @default(uuid())
  projectId       String
  title           String
  description     String?
  priority        TaskPriority @default(MEDIUM)
  status          TaskStatus   @default(TODO)
  dueDate         DateTime?
  dependsOnTaskId String?
  reopenReason    String?
  createdById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User?             @relation("TaskCreatedBy", fields: [createdById], references: [id])
  dependsOn   Task?             @relation("TaskDependency", fields: [dependsOnTaskId], references: [id])
  dependents  Task[]            @relation("TaskDependency")
  assignments TaskAssignment[]
  photos      TaskPhoto[]
  timeLogs    TaskTimeLog[]
  materials   ProjectMaterial[]

  @@index([status])
}

model TaskAssignment {
  id           String   @id @default(uuid())
  taskId       String
  technicianId String
  assignedAt   DateTime @default(now())

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  technician User @relation(fields: [technicianId], references: [id])

  @@unique([taskId, technicianId])
  @@index([technicianId])
}

model TaskPhoto {
  id           String    @id @default(uuid())
  taskId       String
  fileUrl      String
  caption      String?
  type         PhotoType @default(PROGRESS)
  uploadedById String?
  createdAt    DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskTimeLog {
  id           String    @id @default(uuid())
  taskId       String
  technicianId String
  startedAt    DateTime
  endedAt      DateTime?
  minutes      Int?
  note         String?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TechnicianProfile {
  id             String     @id @default(uuid())
  userId         String     @unique
  skills         String[]   @default([])
  employmentType String     @default("full_time")
  status         UserStatus @default(ACTIVE)

  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaves TechnicianLeave[]
}

model TechnicianLeave {
  id           String      @id @default(uuid())
  technicianId String
  startDate    DateTime
  endDate      DateTime
  reason       String?
  status       LeaveStatus @default(REQUESTED)

  technician TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────
// PHASE 4 — FINANCE: Materials, Expenses, Invoices, Payments
// ─────────────────────────────────────────────────────────────────────────

model ProjectMaterial {
  id           String            @id @default(uuid())
  projectId    String
  taskId       String?
  type         MaterialEntryType
  itemName     String
  quantity     Decimal           @db.Decimal(10, 2)
  unit         String
  receiptUrl   String?
  recordedById String?
  createdAt    DateTime          @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id])
}

model Expense {
  id              String          @id @default(uuid())
  projectId       String?
  category        ExpenseCategory
  amount          Decimal         @db.Decimal(12, 2)
  date            DateTime
  description     String?
  receiptUrl      String?
  status          ExpenseStatus   @default(SUBMITTED)
  submittedById   String?
  approvedById    String?
  rejectionReason String?
  createdAt       DateTime        @default(now())

  project     Project? @relation(fields: [projectId], references: [id])
  submittedBy User?    @relation("ExpenseSubmittedBy", fields: [submittedById], references: [id])
  approvedBy  User?    @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])

  @@index([status])
  @@index([date])
}

model Invoice {
  id         String        @id @default(uuid())
  invoiceNo  String        @unique
  projectId  String
  customerId String
  status     InvoiceStatus @default(DRAFT)
  issueDate  DateTime      @default(now())
  dueDate    DateTime
  subtotal   Decimal       @db.Decimal(12, 2)
  taxAmount  Decimal       @default(0) @db.Decimal(12, 2)
  total      Decimal       @db.Decimal(12, 2)
  amountPaid Decimal       @default(0) @db.Decimal(12, 2)
  balance    Decimal       @db.Decimal(12, 2)
  voidReason String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  project   Project           @relation(fields: [projectId], references: [id])
  customer  Customer          @relation(fields: [customerId], references: [id])
  lineItems InvoiceLineItem[]
  payments  Payment[]

  @@index([status])
  @@index([customerId])
  @@index([projectId])
}

model InvoiceLineItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id             String        @id @default(uuid())
  invoiceId      String
  customerId     String
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  referenceNo    String?
  paidAt         DateTime      @default(now())
  recordedById   String?
  reversedAt     DateTime?
  reversalReason String?
  createdAt      DateTime      @default(now())

  invoice    Invoice  @relation(fields: [invoiceId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id])
  recordedBy User?    @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  @@index([customerId])
  @@index([paidAt])
}

// ─────────────────────────────────────────────────────────────────────────
// PHASE 5 — INSIGHT & POLISH: Notifications, Audit Log, Feedback
// ─────────────────────────────────────────────────────────────────────────

model Notification {
  id         String           @id @default(uuid())
  userId     String
  type       NotificationType
  title      String
  body       String
  isRead     Boolean          @default(false)
  entityType String?
  entityId   String?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}

model CustomerFeedback {
  id         String   @id @default(uuid())
  projectId  String
  customerId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  project  Project  @relation(fields: [projectId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
}
