# Database — Supabase project (Project Settings > Database > Connect)
#
# IMPORTANT: Supabase's direct-connection host (db.<ref>.supabase.co:5432) resolves
# to an IPv6-only address. If your network/ISP doesn't have working outbound IPv6,
# every query will fail with "Can't reach database server" even with a correct
# password. Use the connection pooler instead — it's IPv4-reachable.
#
# DATABASE_URL: "Transaction pooler" string (port 6543) — used by the app at runtime.
#   Must include ?pgbouncer=true so Prisma disables prepared statements, which the
#   transaction pooler doesn't support.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: "Session pooler" string (port 5432 on the same pooler host) — used only
# by `prisma migrate`/`db push`, which need a direct-style connection (advisory locks)
# that the transaction pooler doesn't support. Also IPv4-reachable.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Local Postgres example (no pooler needed):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/sms_dev?schema=public"
# DIRECT_URL="postgresql://postgres:password@localhost:5432/sms_dev?schema=public"

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Supabase Storage
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="change-me"
SUPABASE_STORAGE_BUCKET="sms-uploads"
